# Local development: copy this file to .env and replace the values. Never commit .env.
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
DATABASE_URL=postgresql+psycopg://signalloop_app:change-this-password@localhost:5432/signalloop
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30

# Production (set these on your host instead of in a file; render.yaml wires most of them for Render):
# APP_ENV=production            # turns on strict startup checks (strong secrets, PostgreSQL, explicit CORS)
# FLASK_DEBUG=0
# SECRET_KEY / JWT_SECRET_KEY   # two different random values, 32+ characters each
# DATABASE_URL                  # postgres:// and postgresql:// URLs from your host are accepted as-is
# CORS_ORIGINS=https://your-site.netlify.app   # exact frontend origin(s), comma separated, no trailing slash

# Optional: create the first admin automatically on start (skipped if the account already exists).
# ADMIN_EMAIL=admin@your-school.edu
# ADMIN_PASSWORD=at-least-12-characters
# ADMIN_NAME=Campus Admin
