# Copy this file to .env and replace the values. Never commit .env.
FLASK_APP=run.py
# Local development only. Leave FLASK_DEBUG unset (or 0) in production.
FLASK_DEBUG=1
# Two different long random values; the app refuses to start outside development
# while these still hold the placeholder values.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
# PostgreSQL in production; SQLite only works for throwaway local experiments.
DATABASE_URL=postgresql+psycopg://signalloop_app:change-this-password@localhost:5432/signalloop
# Only needed when a browser calls the API cross-origin instead of through the
# site's /api proxy: list the front end origins here, comma separated.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
# Set by the host (Render, Fly, a VM...). run.py and gunicorn both read it.
# PORT=8000
